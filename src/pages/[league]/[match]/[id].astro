---
import '../../../styles/global.css';
import { fetchMatchById } from '../../../utils/api.js';

const { league, match: matchSlug, id } = Astro.params;

const matchData = await fetchMatchById(id);

if (!matchData) {
  return Astro.redirect('/');
}

const matchTitle = matchData.team2
  ? `${matchData.team1} vs ${matchData.team2}`
  : matchData.team1;

const pageTitle = `${matchTitle} – ${matchData.league} Match Preview | CrackStreams`;

const pageDescription = `Explore ${matchTitle} with useful ${matchData.league} information, including the scheduled date, start time, team matchup, fixture details, and latest updates on CrackStreams.`;
---

