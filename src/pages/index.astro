---
import '../styles/global.css';
import { fetchMatches } from '../utils/api.js';

const matches = await fetchMatches();

interface LeagueGroup {
  league: string;
  leagueLogo: string;
  sport: string;
  matches: typeof matches;
}

const leaguesMap = new Map<string, LeagueGroup>();

for (const match of matches) {
  const leagueKey = (match.league && match.league.trim()) || 'Other League';
  if (!leaguesMap.has(leagueKey)) {
    leaguesMap.set(leagueKey, {
      league: leagueKey,
      leagueLogo: match.leagueLogo || '',
      sport: match.sport || '',
      matches: []
    });
  } else if (!leaguesMap.get(leagueKey)!.leagueLogo && match.leagueLogo) {
    leaguesMap.get(leagueKey)!.leagueLogo = match.leagueLogo;
  }
  leaguesMap.get(leagueKey)!.matches.push(match);
}

const leaguesList = Array.from(leaguesMap.values());
